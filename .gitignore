# The repository publishes Creator Toolkit and its Agent Director test bridge
# for AI agents only. Everything else in this
# working folder (other experiments, game references, saves, logs, backups)
# stays local: the list below is a whitelist.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD-PARTY-NOTICES.md
# Agent Director: agent cheat sheets and the ct CLI entry point
!/AGENTS.md
!/AGENT-DIRECTOR.md
!/ct.cmd

!/src/
/src/*
!/src/creator/
!/src/agentdirector/

!/tools/
/tools/*
!/tools/ct-test/
!/tools/ct.ps1

# Build output
bin/
obj/

# Internal QA notes, validation reports and local backups
/src/creator/qa/
/src/creator/REPORT-*.md
/src/creator/VALIDATION*.md
/src/creator/STRESS-VALIDATION*.md
/src/creator/VISUAL-QA-*.md
/src/creator/WORKLOG-*.md
*.bak
*.rollback
*.pending
*.log
