  </ItemGroup>
  <!-- This repository uses an executable offline checker, not an adapter-based
       xUnit project. Make the exact dotnet test command execute it and propagate
       every failure; never report a zero-discovery exit as a successful suite. -->
  <PropertyGroup>
    <CreatorToolkitRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\'))</CreatorToolkitRoot>
    <CreatorToolkitHost>$(CreatorToolkitRoot)_work\dotnet\dotnet.exe</CreatorToolkitHost>
  </PropertyGroup>
  <Target Name="RunCreatorToolkitOfflineChecks" BeforeTargets="VSTest" DependsOnTargets="Build"
          Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <Error Condition="!Exists('$(CreatorToolkitHost)')" Text="Repository-local dotnet host is required." />
    <Message Importance="high" Text="CreatorToolkit: running real offline policy/metadata checks (no native game or save access)." />
    <Exec Command="&quot;$(CreatorToolkitHost)&quot; build &quot;$(MSBuildThisFileDirectory)..\CreatorToolkit.csproj&quot; -c Release -o &quot;$(CreatorToolkitRoot)_work\creator-stage&quot; -nologo -v minimal --no-incremental --ignore-failed-sources -p:UseSharedCompilation=false" />
    <Exec Command="&quot;$(CreatorToolkitHost)&quot; &quot;$(TargetPath)&quot; &quot;$(CreatorToolkitRoot).&quot;" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\test-audit-integrity.ps1&quot;" />
  </Target>
</Project>
